{
  "name": "resume-os",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "RESUME_OS_LOCAL_ONLY=1 next dev --hostname 127.0.0.1 -p 3001",
    "build": "next build",
    "start": "RESUME_OS_LOCAL_ONLY=1 next start --hostname 127.0.0.1",
    "start:server": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "test:production-extraction": "next build && node scripts/smoke-document-extraction.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "node scripts/check.mjs",
    "release": "release-it --ci --config .release-it.cjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.7",
    "@napi-rs/canvas": "0.1.80",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "ai": "7.0.15",
    "clsx": "2.1.1",
    "lucide-react": "1.23.0",
    "mammoth": "^1.12.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "next-intl": "^4.13.1",
    "pdf-parse": "^2.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-rnd": "^10.5.3",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "yauzl": "3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@release-it/conventional-changelog": "11.0.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.12.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@types/yauzl": "3.4.0",
    "autoprefixer": "10.5.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "8.5.23",
    "release-it": "20.2.1",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": ">=11.17.0 <12"
  }
}
