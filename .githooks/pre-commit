#!/usr/bin/env bash
# pre-commit: whitespace + secret path deny-globs on staged files.
# Bash 3.2 compatible.
set -euo pipefail

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  exit 0
fi

if ! git diff --cached --check; then
  echo "pre-commit: fix whitespace or conflict marker issues in the staged diff." >&2
  exit 1
fi

deny_regex='(^|/)\.env($|\.)|(^|/).*\.pem$|(^|/).*\.p12$|(^|/)id_rsa|(^|/)sessions/|(^|/)\.local/|credentials|secret'

IFS=$'\n'
for path in $(git diff --cached --name-only --diff-filter=ACMR); do
  [ -z "$path" ] && continue
  if printf '%s' "$path" | grep -Eiq "$deny_regex"; then
    case "$path" in
      *.example|*.example.*|*.sample|*.sample.*) continue ;;
    esac
    echo "pre-commit: refusing to stage high-risk path: $path" >&2
    exit 1
  fi
  case "$path" in
    *.sh)
      if [ -f "$path" ]; then
        bash -n "$path"
      fi
      ;;
  esac
done

exit 0
